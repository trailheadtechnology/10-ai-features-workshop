### Stretch: the human gate. Do NOT send this until you have said yes out loud.
# When the model calls request_permit, stop. Print (well, read) the arguments it
# chose: park, zone, dates, group_size. That is the summary a human approves. Only
# if you agree does the tool "run" and its result go back, which in this file means
# only then do you send this request. If you decline, send the cancelled result
# instead; the model should finish the itinerary and say no permit was filed.
#
# The whole message list from step 3 goes above the assistant/tool pair below; the
# tail is all that changes.
POST https://trailhead-ai-workshop.openai.azure.com/openai/deployments/gpt-5.5/chat/completions?api-version=2024-10-21
Content-Type: application/json
api-key: <KEY FROM INSTRUCTOR>

{
  "messages": [
    { "role": "system", "content": "...same system prompt as step 3..." },
    { "role": "user", "content": "...same user request, and every assistant/tool pair from your step 3 loop, in order..." },
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "CALL-ID-PERMIT",
          "type": "function",
          "function": { "name": "request_permit", "arguments": "{\"park\":\"Glacier National Park\",\"zone\":\"Lake McDonald / Sperry\",\"dates\":\"2026-09-14 to 2026-09-16\",\"group_size\":2}" }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "CALL-ID-PERMIT",
      "content": "{\"status\":\"submitted\",\"confirmation_id\":\"TRG-2026-091482\",\"message\":\"Permit request received. You will be notified by email when a ranger reviews your request, typically within 24 hours. This is a request, not a confirmed permit.\",\"next_steps\":[\"Check your email for a review decision.\",\"Carry printed confirmation on your trip.\",\"Walk-up conversion available at the Apgar Backcountry Permit Center.\"]}"
    }
  ],
  "tools": [ "...same five tools as step 3..." ],
  "tool_choice": "auto"
}

# --- Declined instead? Send this as the tool content and watch what the model does. ---
# The reference implementation returns exactly this string, and the instruction not
# to retry is there because a model that gets a bare "cancelled" will often try again.
#    "content": "{\"status\":\"cancelled\",\"message\":\"The user declined to file the permit request. Do not retry; finish the itinerary and note that no permit was filed.\"}"
#
# You are also the step budget. Decide now how many round-trips you will do before
# you stop (dotnet/complete caps at a handful), and if you hit it, that is a finding
# worth writing down, not a reason to keep pasting.
