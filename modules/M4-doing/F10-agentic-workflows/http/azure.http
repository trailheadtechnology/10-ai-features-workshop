### 3. Step 3: the washed-out bridge. All five tools, a request for the closed trail.
# The catalog entry for Avalanche Lake Trail (trail-0117) says nothing about the
# bridge; only get_trail_conditions does. Run the loop. When the model calls
# get_trail_conditions with trail-0117, hand back the result below (the newest four
# reports on file, exactly what the .NET tool returns). For any other trail id, reply
# with {"error": "No condition reports found for 'trail-XXXX'."} or make up a
# benign report; the point is what happens with 0117.
#
# The request names trail-0117 outright, the same way the reference transcript's
# second run does. Avalanche Lake is not in the default top-8 search result (the
# tool caps at 8), so hand back the ["waterfall"] search below, which does include
# it, whatever filter the model actually chose. If it skips searching and goes
# straight to get_trail_conditions with the id, that is fine too.
# Why the id is in the request: the code tools match keywords against trail names
# too, but here you are the tool, and without the id or a name match the model has
# no way to reach a trail the catalog buries at position 27. Soak-tested: with only
# the name and a tag-only search, 6 of 10 runs never found it.
# Passing: the itinerary drops or flags the trail and says why, and the reason
# came from the tool result, not from the model's imagination.
POST https://trailhead-ai-workshop.openai.azure.com/openai/deployments/gpt-5.5/chat/completions?api-version=2024-10-21
Content-Type: application/json
api-key: <KEY FROM INSTRUCTOR>

{
  "messages": [
    {
      "role": "system",
      "content": "You are the trip-planning agent for Trailhead Guides, a hiking app. Today's date is September 11, 2026. Plan trips using your tools; never invent trails, weather, availability, or conditions. Every trail name, forecast, campground, and condition in your answer must have come back from a tool call in this conversation. Call the tools one at a time, in this order, and do not write any part of the itinerary until all of them have been called: 1. get_weather for the park. 2. search_trails for candidate trails that fit the request. 3. get_trail_conditions for EVERY trail you intend to recommend, one call per trail, using the trail id returned by search_trails. If the newest reports for a trail mention a closure, a washout, a bridge that is out, or any other reason hikers are turning around, that trail is CLOSED. Do not schedule a day on a closed trail. Replace it with another trail from search_trails and state plainly, in the itinerary, that the original trail is closed and why. 4. check_campsites for where to stay each night. 5. request_permit once, only if a backcountry site or permit zone is involved. If you have not yet called search_trails and get_trail_conditions, your next move is a tool call, not prose. Then write the final itinerary: one section per day with trail, campsite, and how the forecast shaped the choice. End with the permit status."
    },
    {
      "role": "user",
      "content": "Plan me a 3-day trip in Glacier National Park for September 14-16 that includes the Avalanche Lake Trail (trail-0117)."
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "search_trails",
        "description": "Search the trail catalog. Returns matching trails with id, name, park, distance, elevation, difficulty, and features. Call this before recommending any trail; trail ids from here are what the other tools expect.",
        "parameters": {
          "type": "object",
          "properties": {
            "park": { "type": "string", "description": "Park name, for example 'Glacier National Park'. Partial names like 'Glacier' also match." },
            "features": { "type": "array", "items": { "type": "string" }, "description": "Optional keywords matched against each trail's features and its name, for example ['lake', 'waterfall'] or ['Avalanche Lake']." },
            "max_difficulty": { "type": "string", "enum": ["easy", "moderate", "hard"], "description": "Optional ceiling on difficulty. 'moderate' returns easy and moderate trails." }
          },
          "required": ["park"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get the multi-day forecast and advisories for a park. Returns one entry per date with high, low, conditions, chance of precipitation, and wind.",
        "parameters": {
          "type": "object",
          "properties": {
            "park": { "type": "string", "description": "Park name, for example 'Glacier National Park'." }
          },
          "required": ["park"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_trail_conditions",
        "description": "Get the most recent hiker-submitted condition reports for one trail, newest first. Call this for every trail you intend to recommend. Reports are where closures, washouts, and hazards show up; the catalog entry will not mention them.",
        "parameters": {
          "type": "object",
          "properties": {
            "trail_id": { "type": "string", "description": "A trail id returned by search_trails, for example 'trail-0117'." }
          },
          "required": ["trail_id"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "check_campsites",
        "description": "Check campground availability for a park. Returns each campground with open sites per date, whether it is frontcountry or backcountry, amenities, and notes such as seasonal closures.",
        "parameters": {
          "type": "object",
          "properties": {
            "park": { "type": "string", "description": "Park name, for example 'Glacier National Park'." }
          },
          "required": ["park"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "request_permit",
        "description": "Submit a backcountry permit request. This files a request on the user's behalf, so call it once, at the end, after the plan is settled and the user has confirmed.",
        "parameters": {
          "type": "object",
          "properties": {
            "park": { "type": "string", "description": "Park name, for example 'Glacier National Park'." },
            "zone": { "type": "string", "description": "Permit zone, for example 'Lake McDonald / Sperry' or 'Many Glacier'." },
            "dates": { "type": "string", "description": "Trip dates, for example '2026-09-14 to 2026-09-16'." },
            "group_size": { "type": "integer", "description": "Number of people in the group. Zones cap out at 8 in Glacier." }
          },
          "required": ["park", "zone", "dates", "group_size"]
        }
      }
    }
  ],
  "tool_choice": "auto"
}

# --- Tool results for step 3. Weather and campsites are the same as steps 1-2. ---
#
# search_trails with {"park":"Glacier National Park","features":["waterfall"]}
# (real output; Avalanche Lake is in the catalog like any other trail, and nothing
# in this payload hints at the bridge):
#    "content": "[{\"id\":\"trail-0033\",\"name\":\"Running Eagle Falls Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":0.6,\"elevation_ft\":50,\"difficulty\":\"easy\",\"features\":[\"waterfall\",\"accessible\",\"family-friendly\"]},{\"id\":\"trail-0108\",\"name\":\"Virginia Falls Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":3.6,\"elevation_ft\":520,\"difficulty\":\"moderate\",\"features\":[\"waterfall\",\"creek\",\"family-friendly\"]},{\"id\":\"trail-0117\",\"name\":\"Avalanche Lake Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":4.6,\"elevation_ft\":730,\"difficulty\":\"moderate\",\"features\":[\"waterfall\",\"lake\",\"gorge\",\"family-friendly\"]},{\"id\":\"trail-0151\",\"name\":\"Cobalt Lake Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":11.4,\"elevation_ft\":1400,\"difficulty\":\"moderate\",\"features\":[\"lake\",\"waterfall-adjacent\",\"wildflowers\"]},{\"id\":\"trail-0178\",\"name\":\"Lincoln Lake Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":16.0,\"elevation_ft\":2350,\"difficulty\":\"hard\",\"features\":[\"lake\",\"waterfall-adjacent\",\"deep-solitude\"]}]"
