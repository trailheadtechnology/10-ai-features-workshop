# Lab 10: one tool-calling round-trip by hand, against Azure OpenAI.
#
# In this file YOU are the agent loop. The model picks a tool; you copy the call
# out of its response, run the "tool" (paste a canned result from below), send the
# result back, and repeat until you get an itinerary instead of a tool call.
# That copy-paste is exactly what dotnet/complete's function-invocation loop
# automates, and doing it once by hand is the fastest way to see what agent
# frameworks hide.
#
# The endpoint and deployment name are already filled in; replace <KEY FROM
# INSTRUCTOR> with the key handed out in the room (same key as F00's smoke-test.http).
# This lab uses the gpt-5.5 deployment, the frontier model; features 03 and 05 use gpt-4.1.
#
# The tool results below are the real outputs of the .NET tools over the workshop
# data in data/ (trails.json, condition-reports.jsonl, mock-apis/*), so what
# you hand back is what the demo hands back.
#
# Two things to know before you start:
#  - Every tool_call the model returns has an "id". The tool message you send back
#    must carry the same id in "tool_call_id", and the assistant message that made
#    the call has to be replayed in the conversation before it. Wherever you see
#    CALL-ID below, paste the id from your own response.
#  - Argument strings vary run to run. Copy the assistant message out of YOUR
#    response rather than trusting the sample; the sample shows the shape.

### 1a. Step 1: two tools, first turn. Expect finish_reason "tool_calls", not prose.
POST https://trailhead-ai-workshop.openai.azure.com/openai/deployments/gpt-5.5/chat/completions?api-version=2024-10-21
Content-Type: application/json
api-key: <KEY FROM INSTRUCTOR>

{
  "messages": [
    {
      "role": "system",
      "content": "You are the trip-planning agent for Trailhead Guides, a hiking app. Today's date is September 11, 2026. Plan trips using your tools; never invent trails, campgrounds, or availability. Every trail name and campground in your answer must have come back from a tool call in this conversation. Call search_trails and check_campsites before writing any part of the itinerary. If you have not yet called both, your next move is a tool call, not prose."
    },
    {
      "role": "user",
      "content": "Plan me a 3-day trip in Glacier National Park for September 14-16."
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "search_trails",
        "description": "Search the trail catalog. Returns matching trails with id, name, park, distance, elevation, difficulty, and features. Call this before recommending any trail; trail ids from here are what the other tools expect.",
        "parameters": {
          "type": "object",
          "properties": {
            "park": { "type": "string", "description": "Park name, for example 'Glacier National Park'. Partial names like 'Glacier' also match." },
            "features": { "type": "array", "items": { "type": "string" }, "description": "Optional keywords matched against each trail's features and its name, for example ['lake', 'waterfall'] or ['Avalanche Lake']." },
            "max_difficulty": { "type": "string", "enum": ["easy", "moderate", "hard"], "description": "Optional ceiling on difficulty. 'moderate' returns easy and moderate trails." }
          },
          "required": ["park"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "check_campsites",
        "description": "Check campground availability for a park. Returns each campground with open sites per date, whether it is frontcountry or backcountry, amenities, and notes such as seasonal closures.",
        "parameters": {
          "type": "object",
          "properties": {
            "park": { "type": "string", "description": "Park name, for example 'Glacier National Park'." }
          },
          "required": ["park"]
        }
      }
    }
  ],
  "tool_choice": "auto"
}

### 1b. Step 1: hand back the search_trails result, watch it ask for the next tool.
# Replace the assistant message with the one from YOUR 1a response (its id and
# arguments), then keep the tool message: this is the real search_trails result
# for Glacier, all 8 trails the .NET tool returns for {"park":"Glacier National Park"}.
# If the model asked for check_campsites first instead, swap the order: send it
# the campsites result from 1c now and this trails result on the next turn.
POST https://trailhead-ai-workshop.openai.azure.com/openai/deployments/gpt-5.5/chat/completions?api-version=2024-10-21
Content-Type: application/json
api-key: <KEY FROM INSTRUCTOR>

{
  "messages": [
    {
      "role": "system",
      "content": "You are the trip-planning agent for Trailhead Guides, a hiking app. Today's date is September 11, 2026. Plan trips using your tools; never invent trails, campgrounds, or availability. Every trail name and campground in your answer must have come back from a tool call in this conversation. Call search_trails and check_campsites before writing any part of the itinerary. If you have not yet called both, your next move is a tool call, not prose."
    },
    {
      "role": "user",
      "content": "Plan me a 3-day trip in Glacier National Park for September 14-16."
    },
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "CALL-ID",
          "type": "function",
          "function": { "name": "search_trails", "arguments": "{\"park\":\"Glacier National Park\"}" }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "CALL-ID",
      "content": "[{\"id\":\"trail-0003\",\"name\":\"Trail of the Cedars\",\"park\":\"Glacier National Park\",\"distance_mi\":1.0,\"elevation_ft\":60,\"difficulty\":\"easy\",\"features\":[\"boardwalk\",\"dog-friendly\",\"old-growth\",\"accessible\"]},{\"id\":\"trail-0008\",\"name\":\"Highline Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":11.8,\"elevation_ft\":1950,\"difficulty\":\"hard\",\"features\":[\"alpine\",\"viewpoint\",\"wildlife\",\"ledges\"]},{\"id\":\"trail-0013\",\"name\":\"Iceberg Lake Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":9.6,\"elevation_ft\":1275,\"difficulty\":\"moderate\",\"features\":[\"lake\",\"alpine\",\"wildflowers\",\"bears\"]},{\"id\":\"trail-0019\",\"name\":\"Grinnell Glacier Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":10.6,\"elevation_ft\":1840,\"difficulty\":\"hard\",\"features\":[\"glacier\",\"lake\",\"alpine\",\"wildflowers\"]},{\"id\":\"trail-0021\",\"name\":\"Sperry Chalet Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":6.4,\"elevation_ft\":3432,\"difficulty\":\"hard\",\"features\":[\"historic-chalet\",\"viewpoint\",\"wildlife\"]},{\"id\":\"trail-0028\",\"name\":\"Swiftcurrent Nature Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":2.5,\"elevation_ft\":95,\"difficulty\":\"easy\",\"features\":[\"lake\",\"wildlife\",\"family-friendly\"]},{\"id\":\"trail-0033\",\"name\":\"Running Eagle Falls Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":0.6,\"elevation_ft\":50,\"difficulty\":\"easy\",\"features\":[\"waterfall\",\"accessible\",\"family-friendly\"]},{\"id\":\"trail-0037\",\"name\":\"Bowman Lake Shoreline Trail\",\"park\":\"Glacier National Park\",\"distance_mi\":7.1,\"elevation_ft\":260,\"difficulty\":\"moderate\",\"features\":[\"lake\",\"forest\",\"solitude\"]}]"
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "search_trails",
        "description": "Search the trail catalog. Returns matching trails with id, name, park, distance, elevation, difficulty, and features. Call this before recommending any trail; trail ids from here are what the other tools expect.",
        "parameters": {
          "type": "object",
          "properties": {
            "park": { "type": "string", "description": "Park name, for example 'Glacier National Park'. Partial names like 'Glacier' also match." },
            "features": { "type": "array", "items": { "type": "string" }, "description": "Optional keywords matched against each trail's features and its name, for example ['lake', 'waterfall'] or ['Avalanche Lake']." },
            "max_difficulty": { "type": "string", "enum": ["easy", "moderate", "hard"], "description": "Optional ceiling on difficulty. 'moderate' returns easy and moderate trails." }
          },
          "required": ["park"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "check_campsites",
        "description": "Check campground availability for a park. Returns each campground with open sites per date, whether it is frontcountry or backcountry, amenities, and notes such as seasonal closures.",
        "parameters": {
          "type": "object",
          "properties": {
            "park": { "type": "string", "description": "Park name, for example 'Glacier National Park'." }
          },
          "required": ["park"]
        }
      }
    }
  ],
  "tool_choice": "auto"
}

### 1c. Step 1: hand back the check_campsites result, get the itinerary.
